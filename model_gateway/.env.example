# 复制为 .env 后填写。仅 mode=real 时生效;mock 模式不需要任何 key。

# 网关自身配置(均可用环境变量覆盖 config.yaml)
# GW_MODE=real
# GW_MAX_CONCURRENCY=8
# GW_REQUEST_TIMEOUT=60
# GW_UPSTREAM_TIMEOUT=15
# GW_IDEMPOTENCY_TTL=300

# ---- provider API keys(对应 config.yaml 里的 api_key_env)----
OPENAI_API_KEY=sk-xxxx
DEEPSEEK_API_KEY=sk-xxxx
DASHSCOPE_API_KEY=sk-xxxx
MOONSHOT_API_KEY=sk-xxxx

# ---- 可选:OpenAI 专属代理(本机直连不通时)----
# OPENAI_PROXY=http://127.0.0.1:7890
