# StepFun API 配置 (使用Step模型)
# Get your API key from: https://platform.stepfun.com/

# 基础配置
COMIC_BASE_URL=https://api.stepfun.com/v1
COMIC_API_KEY=your_stepfun_api_key_here

# 对话模型 (选择: step-1-16k, step-2-16k, step-3-32k 等)
COMIC_CHAT_MODEL=step-2-16k

# 图像生成模型 (选择: step-1-32k 等)
COMIC_IMAGE_MODEL=step-1-32k

# 视觉质检模型 (可选，留空则使用COMIC_CHAT_MODEL)
COMIC_VISION_BASE_URL=https://api.stepfun.com/v1
COMIC_VISION_API_KEY=your_stepfun_api_key_here
# COMIC_VISION_MODEL=step-3-32k

# 图生图编辑通道 (已配置为step-image-edit-2)
COMIC_EDIT_BASE_URL=https://api.stepfun.com/step_plan/v1
COMIC_EDIT_API_KEY=your_stepfun_api_key_here
COMIC_EDIT_MODEL=step-image-edit-2
