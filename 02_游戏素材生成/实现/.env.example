# 模型端点(OpenAI 兼容代理,与 01_漫画生成 同一服务)
ASSET_BASE_URL=http://your-proxy:3000/v1
ASSET_API_KEY=sk-your-key

# 模型名
ASSET_CHAT_MODEL=grok-chat-fast
ASSET_IMAGE_MODEL=grok-imagine-image-quality-lite
# 视觉审核模型(留空 = 自动降级跳过,返回草稿给调用方 AI 兜底)
ASSET_VISION_MODEL=

# 视觉审核可挂独立服务商(OpenAI 兼容即可);留空与主端点共用。
# 配好后运行: uv run python check_vision.py 一键验证
ASSET_VISION_BASE_URL=
ASSET_VISION_API_KEY=

# 图生图编辑通道(StepFun 官方 step-image-edit-2;/images/edits multipart)。
# 用于动画帧条件生成(锚帧+改姿势,压帧间漂移)与 generate_asset 带反馈重生成的保形改图。
# API key 留空 = 不启用,动画退回逐帧文生图(行为与未接入时一致)。
# 配好后运行: uv run python check_edit.py 一键验证
ASSET_EDIT_BASE_URL=https://api.stepfun.com/v1
ASSET_EDIT_API_KEY=
ASSET_EDIT_MODEL=step-image-edit-2

# 出网代理(留空=永远直连,无视系统/环境代理;需要时填如 http://127.0.0.1:7890)
ASSET_HTTP_PROXY=
